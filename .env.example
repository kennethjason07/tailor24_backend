# TAILOR24 Backend — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=tailor24

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins — do NOT use * in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Smart Assignment Scoring Weights ─────────────────────────────────────────
SCORE_WEIGHT_GENDER=40
SCORE_WEIGHT_SKILL=25
SCORE_WEIGHT_CAPACITY=10

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ── Object Storage (for QR images & application PDFs) ─────────────────────────
# Set these when you have an S3-compatible bucket; leave blank in development.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
